# ─────────────────────────────────────────────────────────────
# Ojiva Elite NonVeg — Environment template. Copy to backend/.env
# NEVER commit the real .env. Values below are placeholders.
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database (PostgreSQL)
DATABASE_URL=postgresql://elite:elite@localhost:5432/elite_nonveg?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Storage (choose one: s3 | cloudinary)
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_S3_BUCKET=
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# Google Maps
GOOGLE_MAPS_API_KEY=

# Notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Elite NonVeg <no-reply@elitenonveg.com>"
SMS_API_KEY=
SMS_SENDER_ID=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE=

# Store config
STORE_NAME="Elite NonVeg"
STORE_CURRENCY=INR
FREE_SHIPPING_THRESHOLD=699
